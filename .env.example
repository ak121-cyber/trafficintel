# Copy this file to .env and edit it. .env is gitignored; this example is not,
# so never put a real secret in here.
#
#     cp .env.example .env          # macOS / Linux
#     copy .env.example .env        # Windows

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
# A local mongod needs no username or password, which is why the default works
# out of the box. For MongoDB Atlas or any remote server, paste the full
# connection string here - and keep it out of git.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=trafficintel

# ---------------------------------------------------------------------------
# Session signing key
# ---------------------------------------------------------------------------
# Signs the login cookie. Anyone who knows it can mint a session for any
# account, so treat it like a password and use a long random value:
#
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# If this is left unset the server generates one on first start and stores it in
# .jwt_secret (also gitignored). That is fine for local development; set it
# explicitly for anything you share.
JWT_SECRET=

# ---------------------------------------------------------------------------
# Daily credits
# ---------------------------------------------------------------------------
# 15 credits a day at 5 per video is 3 videos a day. The per-day video limit is
# derived from these two numbers rather than configured separately, so the count
# shown in the UI can never disagree with what the backend enforces.
DAILY_CREDITS=15
CREDITS_PER_VIDEO=5

# ---------------------------------------------------------------------------
# Optional shared password
# ---------------------------------------------------------------------------
# Unrelated to user accounts: this puts one extra password in front of the whole
# site, so only people you give it to can even reach the sign-up page. Leave it
# empty for normal use. See docs/SHARING.md.
TRAFFICINTEL_ACCESS_TOKEN=
